# ── Database (MySQL 8 / MariaDB 10.6+) ────────────────────────────
DATABASE_URL="mysql://formstudio:formstudio@127.0.0.1:3306/formstudio"

# ── Auth.js ───────────────────────────────────────────────────────
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST=true

# Public origin used to build share links, embed snippets and QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional ──────────────────────────────────────────────────────
# Email delivery (thank-you emails, response alerts, workflow emails).
# Pick ONE provider; without one, emails are stored in Admin → Email only.
#   Brevo:     https://app.brevo.com/settings/keys/api  (verify the sender in Senders & IP)
# BREVO_API_KEY="xkeysib-..."
#   Mailtrap:  https://mailtrap.io/api-tokens  (live sending needs a verified sending domain)
# MAILTRAP_API_KEY=""
#   Mailtrap sandbox — capture emails in a test inbox instead of delivering them:
# MAILTRAP_USE_SANDBOX="true"
# MAILTRAP_INBOX_ID="1234567"
#   SMTP:    any provider — Gmail (app password), Microsoft 365, SES, Postmark, Mailgun, Zoho…
# SMTP_URL="smtps://user:password@smtp.gmail.com:465"
#   …or the same as separate variables:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_USER="forms@yourdomain.com"
# SMTP_PASS=""
# Sender shown to recipients (must be an address your provider allows)
# EMAIL_FROM="Digital Fueled <forms@yourdomain.com>"
# Force a provider when several are configured: brevo | mailtrap | smtp | log
# EMAIL_PROVIDER=""

# Comma separated origins allowed to frame /dashboard & /admin (default: same-origin only)
# APP_FRAME_ANCESTORS=""

# Key material (>= 16 chars) for encrypting workspace email-provider credentials.
# Falls back to AUTH_SECRET; set it in production so rotating AUTH_SECRET keeps saved credentials readable.
# EMAIL_CREDENTIALS_KEY=""
# Allow automation HTTP nodes / workspace SMTP hosts to reach private network addresses (default: blocked)
# ALLOW_PRIVATE_NETWORK_REQUESTS="false"
