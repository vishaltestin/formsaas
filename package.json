{
  "name": "formstudio",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:push": "prisma db push --config prisma7.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "verify": "npm run db:generate && npm run db:validate && npm run db:deploy && npm run db:seed && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --conditions=react-server --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "fonts:generate": "tsx scripts/fonts/generate-google-fonts.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@getbrevo/brevo": "^6.2.0",
    "@hookform/resolvers": "^7.0.8",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@tanstack/react-table": "^9.3.1",
    "@xyflow/react": "^13.0.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.52.0",
    "mailtrap": "^4.10.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-number-format": "^5.4.5",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "google-font-metadata": "^6.0.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "mailtrap": {
      "nodemailer": "$nodemailer",
      "@types/nodemailer": "$@types/nodemailer"
    }
  }
}
